# Enterprise IT Triage Platform - Environment Configuration Template
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (SQLite for Dev, PostgreSQL for Prod)
DATABASE_URL=sqlite:///./enterprise_helpdesk.db

# Primary AI Engine (Google AI Studio)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Alternative AI Engine (Mistral API - Optional)
MISTRAL_API_KEY=your_mistral_api_key_here

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_db
