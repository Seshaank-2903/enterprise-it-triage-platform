{
  "name": "enterprise-ai-it-helpdesk-monorepo",
  "version": "1.0.0",
  "description": "Enterprise AI IT Helpdesk & Guardrailed Triage Platform",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "cd frontend && npm install && npm run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend run test:run",
    "lint": "npm --prefix frontend run lint",
    "start": "npm --prefix frontend run preview",
    "backend:dev": "powershell -Command \"cd backend; .venv/Scripts/python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000\"",
    "backend:test": "powershell -Command \"cd backend; .venv/Scripts/python.exe -m pytest tests/ -v\""
  },
  "keywords": ["ai", "fastapi", "react", "helpdesk", "rag", "chromadb", "enterprise"],
  "author": "Antigravity Engineering",
  "license": "MIT"
}
